{
  "expo": {
    "name": "Quira",
    "slug": "quira-app-",
    "owner": "quira-company-ca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jeanfuentes.quira"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "package": "com.jeanfuentes.quira",
      "versionCode": 1,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.quira.** { *; }\n-keep class * implements com.facebook.react.bridge.NativeModule { *; }\n-keep class * implements com.facebook.react.bridge.ReactContextBaseJavaModule { *; }\n-keep class * extends com.facebook.react.bridge.ReactContextBaseJavaModule { *; }\n-dontwarn com.facebook.react.**\n-dontwarn expo.modules.**"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "44ac423f-c155-4ba6-b867-2c718b2bac4c"
      }
    }
  }
}
